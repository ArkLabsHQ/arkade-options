  "source": {
    "entry": "beacon_option_vault.ark",
    "files": {
      "beacon_option_vault.ark": "pragma arkade ^0.1.0;\n\n// Cash-settled covered call (kind 0) and limited put (kind 1) that reads its\n// settlement price from an AttestationBeacon spent in the same transaction.\n//\n// The vault commits to the beacon's identity asset (beaconTxid, beaconGidx),\n// not to the beacon script or the committee keys. Settle spends this coin as\n// input 0 and the beacon as input 1. A third input may pay the beacon's read\n// fee. Output 0 is the beacon's continuation, enforced by the beacon's `read`\n// leaf. Payouts start at output 1.\n//\n// The settlement price is the newest fixing whose key equals `expiry` in the\n// beacon state packet the beacon coin was created with: the first 8 bytes of\n// that slot's value, in USD cents. Payoff in sats, division truncates:\n//   covered call: ST <= K -> holder 0, else Q*(ST-K)/ST\n//   limited put:  ST >= K -> holder 0, else min(Q, Q*(K-ST)/ST)\n// A leg of DUST sats or less is folded into the other output.\n//\n// Spend paths: settle (anyone, once the emulator clock reaches expiry), close\n// (writer and holder together), unilateral (writer, after CSV).\n\ncontract BeaconOptionVault(\n  int kind,\n  pubkey writerPk,\n  pubkey holderPk,\n  bytes32 writerScript,\n  bytes32 holderScript,\n  int strike,\n  int collateral,\n  int expiry,\n  bytes32 beaconTxid,\n  int beaconGidx,\n  int exit\n) {\n  const int DUST = 330;\n  const int PRICE_MAX = 1000000000;\n  const int Q_MAX = 1000000000;\n  const int STATE = 32;\n  const int SIZE = 329;\n\n  function settle() {\n    require(kind == 0 || kind == 1, \"kind\");\n    require(strike > 0, \"strike\");\n    require(strike <= PRICE_MAX, \"strike cap\");\n    require(collateral > DUST, \"collateral\");\n    require(collateral <= Q_MAX, \"collateral cap\");\n    require(checkTime(expiry), \"before expiry\");\n    require(this.activeInputIndex == 0, \"vault is input 0\");\n    require(tx.numInputs >= 2, \"vault and beacon\");\n    require(tx.inputs[1].assets.lookup(beaconTxid, beaconGidx) == 1, \"beacon\");\n\n    bytes state = tx.inputs[1].packet(STATE);\n    require(size(state) == SIZE, \"state size\");\n    require(substr(state, 0, 1) == 0x01, \"state version\");\n\n    int st = 0;\n    int found = 0;\n    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];\n    for (i, offset) in slots {\n      if (found == 0 && substr(state, offset, 8) == num2bin(expiry, 8)) {\n        st = bin2num(substr(state, (offset + 8), 8));\n        found = 1;\n      }\n    }\n    require(found == 1, \"no fixing for expiry\");\n    require(st > 0, \"price\");\n    require(st <= PRICE_MAX, \"price cap\");\n\n    int ph = 0;\n    if (kind == 0) {\n      if (st > strike) {\n        ph = collateral * (st - strike) / st;\n      }\n    }\n    if (kind == 1) {\n      if (st < strike) {\n        ph = collateral * (strike - st) / st;\n        if (ph > collateral) {\n          ph = collateral;\n        }\n      }\n    }\n    require(ph <= collateral, \"holder overpaid\");\n\n    int locked = tx.input.current.value;\n    require(locked >= collateral, \"underfunded\");\n    int writerAmt = locked - ph;\n\n    if (ph > DUST && writerAmt > DUST) {\n      require(tx.outputs[1].value >= ph, \"holder short\");\n      require(tx.outputs[1].scriptPubKey == holderScript, \"holder script\");\n      require(tx.outputs[2].value >= writerAmt, \"writer short\");\n      require(tx.outputs[2].scriptPubKey == writerScript, \"writer script\");\n    }\n    if (ph <= DUST) {\n      require(tx.outputs[1].value >= locked, \"writer short\");\n      require(tx.outputs[1].scriptPubKey == writerScript, \"writer script\");\n    }\n    if (writerAmt <= DUST && ph > DUST) {\n      require(tx.outputs[1].value >= locked, \"holder short\");\n      require(tx.outputs[1].scriptPubKey == holderScript, \"holder script\");\n    }\n  }\n\n  function close(signature writerSig, signature holderSig) {\n    require(checkSig(writerSig, writerPk), \"writer\");\n    require(checkSig(holderSig, holderPk), \"holder\");\n  }\n\n  function unilateral(signature writerSig) tapscript {\n    require(older(exit));\n    require(checkSig(writerSig, writerPk));\n  }\n}\n"
    }
  },
