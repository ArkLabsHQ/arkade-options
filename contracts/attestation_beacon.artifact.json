  "source": {
    "entry": "attestation_beacon.ark",
    "files": {
      "attestation_beacon.ark": "pragma arkade ^0.1.0;\n\n// AttestationBeacon: a committee-signed registry that other covenants read\n// by spending it in the same transaction.\n//\n// Identity is an asset, not a script. The beacon coin carries one unit of an\n// asset (ctrlTxid, ctrlGidx) that was issued once, uncontrolled, with supply\n// 1. arkd never reissues an asset that has no control asset, so exactly one\n// coin holds that unit, and every cooperative spend of that coin runs one of\n// the leaves below. A consumer commits to the asset id only, checks the\n// issuance once, and keeps reading after the committee moves the unit to a\n// new script with `migrate`.\n//\n// State is the extension packet of type STATE in the transaction that created\n// the coin. Layout, 329 bytes:\n//   0        version, 0x01\n//   1..9     round, num2bin(round, 8)\n//   9..329   8 slots of 40 bytes, newest first: key num2bin(key, 8), value 32 bytes\n// `attest` writes slot 0 and shifts the other seven. A key that is in a slot\n// cannot be attested again while it is there. A key that fell off may be\n// attested again, with the same signatures if anyone kept them.\n//\n// Messages, signed by threshold-of-5 committee keys. An absent signer passes an\n// empty signature; a wrong non-empty signature fails the script.\n//   attest:  sha256(domain + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(key, 8) + value)\n//   migrate: sha256(domain + \"migrate\" + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(round, 8) + next)\n//\n// Every leaf continues the coin at output 0: same script (or `next` for\n// migrate), at least the same value, the asset unit, the packet. `read` adds\n// readFee sats to the coin. A read pins nothing else about its transaction.\n\ncontract AttestationBeacon(\n  bytes32 ctrlTxid,\n  int ctrlGidx,\n  pubkey[5] signers,\n  int threshold,\n  bytes domain,\n  int keyLag,\n  int readFee,\n  pubkey adminPk,\n  int exit\n) {\n  const int STATE = 32;\n  const int SIZE = 329;\n  const int SLOTS = 9;\n  const int VALUE_AT = 17;\n  const int HISTORY_AT = 49;\n  const int HISTORY = 280;\n\n  private function quorum(bytes32 message, signature[5] sigs) {\n    require(threshold >= 1, \"threshold floor\");\n    require(threshold <= 5, \"threshold cap\");\n    require(signers[0] != signers[1], \"duplicate signer\");\n    require(signers[0] != signers[2], \"duplicate signer\");\n    require(signers[0] != signers[3], \"duplicate signer\");\n    require(signers[0] != signers[4], \"duplicate signer\");\n    require(signers[1] != signers[2], \"duplicate signer\");\n    require(signers[1] != signers[3], \"duplicate signer\");\n    require(signers[1] != signers[4], \"duplicate signer\");\n    require(signers[2] != signers[3], \"duplicate signer\");\n    require(signers[2] != signers[4], \"duplicate signer\");\n    require(signers[3] != signers[4], \"duplicate signer\");\n    int valid = 0;\n    for (i, sig) in sigs {\n      if (checkSigFromStack(sig, signers[i], message)) {\n        valid = valid + 1;\n      }\n    }\n    require(valid >= threshold, \"quorum\");\n  }\n\n  private function continues(bytes state) {\n    require(size(state) == SIZE, \"state size\");\n    require(substr(state, 0, 1) == 0x01, \"state version\");\n    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, \"script\");\n    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, \"identity asset\");\n  }\n\n  private function absent(bytes prev, int key) {\n    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];\n    for (i, offset) in slots {\n      require(substr(prev, offset, 8) != num2bin(key, 8), \"key already in a slot\");\n    }\n  }\n\n  function attest(int key, bytes32 value, signature[5] sigs) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    require(key > 0, \"key\");\n    if (keyLag >= 0) {\n      require(checkTime(key + keyLag), \"before key time\");\n    }\n    quorum(sha256(domain + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(key, 8) + value), sigs);\n\n    bytes prev = tx.inputs[0].packet(STATE);\n    bytes next = tx.packet(STATE);\n    require(size(prev) == SIZE, \"prev size\");\n    absent(prev, key);\n    require(bin2num(substr(next, 1, 8)) == bin2num(substr(prev, 1, 8)) + 1, \"round\");\n    require(substr(next, SLOTS, 8) == num2bin(key, 8), \"slot key\");\n    require(substr(next, VALUE_AT, 32) == value, \"slot value\");\n    require(substr(next, HISTORY_AT, HISTORY) == substr(prev, SLOTS, HISTORY), \"history\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    continues(next);\n  }\n\n  function read(int selfIndex) {\n    require(selfIndex == this.activeInputIndex, \"self index\");\n    bytes state = tx.packet(STATE);\n    require(state == tx.inputs[selfIndex].packet(STATE), \"state carried\");\n    require(tx.outputs[0].value >= tx.input.current.value + readFee, \"read fee\");\n    continues(state);\n  }\n\n  function migrate(bytes32 next, signature[5] sigs) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    bytes state = tx.packet(STATE);\n    require(state == tx.inputs[0].packet(STATE), \"state carried\");\n    require(size(state) == SIZE, \"state size\");\n    int round = bin2num(substr(state, 1, 8));\n    quorum(sha256(domain + \"migrate\" + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(round, 8) + next), sigs);\n    require(tx.outputs[0].scriptPubKey == next, \"next script\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, \"identity asset\");\n  }\n\n  function unilateral(signature adminSig) tapscript {\n    require(older(exit));\n    require(checkSig(adminSig, adminPk));\n  }\n}\n"
    }
  },
