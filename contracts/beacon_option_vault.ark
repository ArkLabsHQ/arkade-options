pragma arkade ^0.1.0;

// Cash-settled covered call (kind 0) and limited put (kind 1) that reads its
// settlement price from an AttestationBeacon spent in the same transaction.
//
// The vault commits to the beacon's identity asset (beaconTxid, beaconGidx),
// not to the beacon script or the committee keys. Settle spends this coin as
// input 0 and the beacon as input 1. A third input may pay the beacon's read
// fee. Output 0 is the beacon's continuation, enforced by the beacon's `read`
// leaf. Payouts start at output 1.
//
// The settlement price is the newest fixing whose key equals `expiry` in the
// beacon state packet the beacon coin was created with: the first 8 bytes of
// that slot's value, in USD cents. Payoff in sats, division truncates:
//   covered call: ST <= K -> holder 0, else Q*(ST-K)/ST
//   limited put:  ST >= K -> holder 0, else min(Q, Q*(K-ST)/ST)
// A leg of DUST sats or less is folded into the other output.
//
// Spend paths: settle (anyone, once the emulator clock reaches expiry), close
// (writer and holder together), unilateral (writer, after CSV).

contract BeaconOptionVault(
  int kind,
  pubkey writerPk,
  pubkey holderPk,
  bytes32 writerScript,
  bytes32 holderScript,
  int strike,
  int collateral,
  int expiry,
  bytes32 beaconTxid,
  int beaconGidx,
  int exit
) {
  const int DUST = 330;
  const int PRICE_MAX = 1000000000;
  const int Q_MAX = 1000000000;
  const int STATE = 32;
  const int SIZE = 329;

  function settle() {
    require(kind == 0 || kind == 1, "kind");
    require(strike > 0, "strike");
    require(strike <= PRICE_MAX, "strike cap");
    require(collateral > DUST, "collateral");
    require(collateral <= Q_MAX, "collateral cap");
    require(checkTime(expiry), "before expiry");
    require(this.activeInputIndex == 0, "vault is input 0");
    require(tx.numInputs >= 2, "vault and beacon");
    require(tx.inputs[1].assets.lookup(beaconTxid, beaconGidx) == 1, "beacon");

    bytes state = tx.inputs[1].packet(STATE);
    require(size(state) == SIZE, "state size");
    require(substr(state, 0, 1) == 0x01, "state version");

    int st = 0;
    int found = 0;
    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];
    for (i, offset) in slots {
      if (found == 0 && substr(state, offset, 8) == num2bin(expiry, 8)) {
        st = bin2num(substr(state, (offset + 8), 8));
        found = 1;
      }
    }
    require(found == 1, "no fixing for expiry");
    require(st > 0, "price");
    require(st <= PRICE_MAX, "price cap");

    int ph = 0;
    if (kind == 0) {
      if (st > strike) {
        ph = collateral * (st - strike) / st;
      }
    }
    if (kind == 1) {
      if (st < strike) {
        ph = collateral * (strike - st) / st;
        if (ph > collateral) {
          ph = collateral;
        }
      }
    }
    require(ph <= collateral, "holder overpaid");

    int locked = tx.input.current.value;
    require(locked >= collateral, "underfunded");
    int writerAmt = locked - ph;

    if (ph > DUST && writerAmt > DUST) {
      require(tx.outputs[1].value >= ph, "holder short");
      require(tx.outputs[1].scriptPubKey == holderScript, "holder script");
      require(tx.outputs[2].value >= writerAmt, "writer short");
      require(tx.outputs[2].scriptPubKey == writerScript, "writer script");
    }
    if (ph <= DUST) {
      require(tx.outputs[1].value >= locked, "writer short");
      require(tx.outputs[1].scriptPubKey == writerScript, "writer script");
    }
    if (writerAmt <= DUST && ph > DUST) {
      require(tx.outputs[1].value >= locked, "holder short");
      require(tx.outputs[1].scriptPubKey == holderScript, "holder script");
    }
  }

  function close(signature writerSig, signature holderSig) {
    require(checkSig(writerSig, writerPk), "writer");
    require(checkSig(holderSig, holderPk), "holder");
  }

  function unilateral(signature writerSig) tapscript {
    require(older(exit));
    require(checkSig(writerSig, writerPk));
  }
}
