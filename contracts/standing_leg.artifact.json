  "source": {
    "entry": "standing_leg.ark",
    "files": {
      "standing_leg.ark": "pragma arkade ^0.1.0;\n\n// One side of an open option offer. The writer funds side 0. A later holder\n// funds side 1. Neither coin names the holder. A matcher spends the two coins\n// in one transaction. fill has no user signature.\n//\n// The vault program is fixed when the writer funds. It names the writer and\n// the terms, not the holder. Packet 33 on the match names the holder. Side 1\n// requires that packet to be the holder who funded this coin. The premium is\n// paid to premiumScript. On side 0 that script is the writer's own payout.\n\ncontract StandingLeg(\n  pubkey userPk,\n  bytes32 userScript,\n  bytes32 premiumScript,\n  bytes32 vaultProgram,\n  int side,\n  int collateral,\n  int premium,\n  int deadline,\n  int exit\n) {\n  const int DUST = 330;\n  const int PARTY = 33;\n  const int PARTY_SIZE = 65;\n\n  function fill() {\n    require(side == 0 || side == 1, \"side\");\n    require(collateral > DUST, \"collateral\");\n    require(premium > DUST, \"premium\");\n    require(!checkTime(deadline), \"expired\");\n    require(tx.numInputs == 2, \"two inputs\");\n\n    bytes party = tx.packet(PARTY);\n    require(size(party) == PARTY_SIZE, \"party\");\n    require(substr(party, 0, 1) == 0x01, \"party version\");\n\n    require(tx.outputs[1].value >= collateral, \"option size\");\n    require(tx.outputs[1].scriptPubKey == vaultProgram, \"vault\");\n\n    int locked = tx.input.current.value;\n    if (side == 0) {\n      require(premiumScript == userScript, \"writer premium\");\n      require(locked >= collateral, \"short collateral\");\n      int change = locked - collateral;\n      require(tx.outputs[0].value >= premium + change, \"premium\");\n      require(tx.outputs[0].scriptPubKey == userScript, \"user\");\n    }\n    if (side == 1) {\n      require(locked >= premium, \"short premium\");\n      require(substr(party, 1, 32) == userPk, \"holder\");\n      require(substr(party, 33, 32) == userScript, \"holder script\");\n      require(tx.outputs[0].value >= premium, \"premium\");\n      require(tx.outputs[0].scriptPubKey == premiumScript, \"writer\");\n      int change = locked - premium;\n      if (change > DUST) {\n        require(tx.outputs[2].value >= change, \"change\");\n        require(tx.outputs[2].scriptPubKey == userScript, \"change\");\n      }\n    }\n  }\n\n  function cancel() {\n    require(tx.numInputs == 1, \"one input\");\n    require(checkTime(deadline), \"open\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"refund\");\n    require(tx.outputs[0].scriptPubKey == userScript, \"user\");\n  }\n\n  function unilateral(signature userSig) tapscript {\n    require(older(exit));\n    require(checkSig(userSig, userPk));\n  }\n}\n"
    }
  },
