pragma arkade ^0.1.0;

// AttestationBeacon: a price registry that other covenants read by spending
// it in the same transaction.
//
// Identity is an asset, not a script. The beacon coin carries one unit of an
// asset (ctrlTxid, ctrlGidx) that was issued once, uncontrolled, with supply
// 1. arkd never reissues an asset that has no control asset, so exactly one
// coin holds that unit, and every cooperative spend of that coin runs one of
// the leaves below. A consumer commits to the asset id only.
//
// State is the extension packet of type STATE in the transaction that created
// the coin. Layout, 329 bytes:
//   0        version, 0x01
//   1..9     round, num2bin(round, 8)
//   9..329   8 slots of 40 bytes, newest first: key num2bin(key, 8), value 32 bytes
// `attest` writes slot 0 and shifts the other seven. The value is
// num2bin(twap, 32). The vault reads the first 8 bytes. A key that is in a
// slot cannot be attested again while it is there.
//
// Five oracle keys sign blinded prices. They cannot write a slot or migrate
// the unit without adminPk. Each print is
// sha256(0x425443555344 || num2bin(price, 8) || num2bin(time, 8)). That
// message names no beacon. Three distinct oracles of the five sign each slice.
// Windows for the latest print of each slice, relative to the expiry key:
//   open   [key-1800, key-1740]
//   mid    [key-960,  key-900]
//   close  [key,      key+60]
// The median of each slice and ST = (mOpen*900 + mMid*900 + mClose*60) / 1860
// are checked here. Prices are USD cents.
//
// adminPk, the oracle service, is the only key that writes a fixing. It signs
// sha256(ctrlTxid || nextPacket). It cannot invent a price the prints do not
// support. `migrate` needs a threshold of the five signers and adminPk, all over
// sha256(domain + "migrate" + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(round, 8) + next).
//
// Every cooperative leaf continues the coin at output 0: same script (or
// `next` for migrate), at least the same value, at least minValue, the asset
// unit, the packet. minValue must be above the 300-sat subdust line. `read`
// adds readFee sats. Testnet deploys set readFee to 0.

contract AttestationBeacon(
  bytes32 ctrlTxid,
  int ctrlGidx,
  pubkey[5] signers,
  int threshold,
  bytes domain,
  int keyLag,
  int readFee,
  int minValue,
  pubkey adminPk,
  int exit
) {
  const int STATE = 32;
  const int SIZE = 329;
  const int SLOTS = 9;
  const int VALUE_AT = 17;
  const int HISTORY_AT = 49;
  const int HISTORY = 280;
  const int PRICE_MAX = 1000000000;

  private function distinctSigners() {
    require(signers[0] != signers[1], "duplicate signer");
    require(signers[0] != signers[2], "duplicate signer");
    require(signers[0] != signers[3], "duplicate signer");
    require(signers[0] != signers[4], "duplicate signer");
    require(signers[1] != signers[2], "duplicate signer");
    require(signers[1] != signers[3], "duplicate signer");
    require(signers[1] != signers[4], "duplicate signer");
    require(signers[2] != signers[3], "duplicate signer");
    require(signers[2] != signers[4], "duplicate signer");
    require(signers[3] != signers[4], "duplicate signer");
  }

  private function quorum(bytes32 message, signature[5] sigs) {
    require(threshold >= 1, "threshold floor");
    require(threshold <= 5, "threshold cap");
    int valid = 0;
    for (i, sig) in sigs {
      if (checkSigFromStack(sig, signers[i], message)) {
        valid = valid + 1;
      }
    }
    require(valid >= threshold, "quorum");
  }

  private function aboveSubdust() {
    require(minValue > 300, "subdust");
  }

  private function continues(bytes state) {
    aboveSubdust();
    require(size(state) == SIZE, "state size");
    require(substr(state, 0, 1) == 0x01, "state version");
    require(tx.outputs[0].value >= tx.input.current.value, "value");
    require(tx.outputs[0].value >= minValue, "minimum");
    require(tx.outputs[0].scriptPubKey == tx.input.current.scriptPubKey, "script");
    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, "identity asset");
  }

  private function absent(bytes prev, int key) {
    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];
    for (i, offset) in slots {
      require(substr(prev, offset, 8) != num2bin(key, 8), "key already in a slot");
    }
  }

  private function median3(int a, int b, int c) int {
    if (a <= b && b <= c) { return b; }
    if (a <= c && c <= b) { return c; }
    if (b <= a && a <= c) { return a; }
    if (b <= c && c <= a) { return c; }
    if (c <= a && a <= b) { return a; }
    return b;
  }

  private function max3(int a, int b, int c) int {
    if (a >= b && a >= c) { return a; }
    if (b >= a && b >= c) { return b; }
    return c;
  }

  private function min3(int a, int b, int c) int {
    if (a <= b && a <= c) { return a; }
    if (b <= a && b <= c) { return b; }
    return c;
  }

  private function distinctWho(int a, int b, int c) {
    require(a != b, "same oracle");
    require(a != c, "same oracle");
    require(b != c, "same oracle");
    require(a >= 0, "oracle index");
    require(a <= 4, "oracle index");
    require(b >= 0, "oracle index");
    require(b <= 4, "oracle index");
    require(c >= 0, "oracle index");
    require(c <= 4, "oracle index");
  }

  private function checkPrint(int price, int time, int index, signature sig) {
    require(price > 0, "nonpositive price");
    require(price <= PRICE_MAX, "price cap");
    require(time > 0, "nonpositive time");
    let ticker = 0x425443555344;
    let msg = sha256(ticker + num2bin(price, 8) + num2bin(time, 8));
    require(checkSigFromStack(sig, signers[index], msg), "bad oracle sig");
  }

  private function slice(int a, int b, int c, int lo, int hi) {
    int top = max3(a, b, c);
    int bot = min3(a, b, c);
    require(top - bot <= 60, "oracle spread");
    require(top >= lo, "slice early");
    require(top <= hi, "slice late");
  }

  function attest(
    int key,
    int[3] price0,
    int[3] time0,
    int[3] who0,
    signature[3] sig0,
    int[3] price1,
    int[3] time1,
    int[3] who1,
    signature[3] sig1,
    int[3] price2,
    int[3] time2,
    int[3] who2,
    signature[3] sig2,
    signature opSig
  ) {
    require(this.activeInputIndex == 0, "beacon is input 0");
    require(key > 1800, "key");
    if (keyLag >= 0) {
      require(checkTime(key + keyLag), "before key time");
    }
    distinctSigners();
    distinctWho(who0[0], who0[1], who0[2]);
    distinctWho(who1[0], who1[1], who1[2]);
    distinctWho(who2[0], who2[1], who2[2]);

    for (i, px) in price0 {
      checkPrint(px, time0[i], who0[i], sig0[i]);
    }
    for (i, px) in price1 {
      checkPrint(px, time1[i], who1[i], sig1[i]);
    }
    for (i, px) in price2 {
      checkPrint(px, time2[i], who2[i], sig2[i]);
    }

    int m0 = median3(price0[0], price0[1], price0[2]);
    int m1 = median3(price1[0], price1[1], price1[2]);
    int m2 = median3(price2[0], price2[1], price2[2]);
    slice(time0[0], time0[1], time0[2], key - 1800, key - 1740);
    slice(time1[0], time1[1], time1[2], key - 960, key - 900);
    slice(time2[0], time2[1], time2[2], key, key + 60);

    int twap = (m0 * 900 + m1 * 900 + m2 * 60) / 1860;
    require(twap > 0, "zero twap");

    bytes prev = tx.inputs[0].packet(STATE);
    bytes next = tx.packet(STATE);
    require(size(prev) == SIZE, "prev size");
    require(size(next) == SIZE, "next size");
    require(substr(prev, 0, 1) == 0x01, "prev version");
    require(substr(next, 0, 1) == 0x01, "next version");
    absent(prev, key);
    require(bin2num(substr(next, 1, 8)) == bin2num(substr(prev, 1, 8)) + 1, "round");
    require(substr(next, SLOTS, 8) == num2bin(key, 8), "slot key");
    require(substr(next, VALUE_AT, 32) == num2bin(twap, 32), "slot value");
    require(substr(next, HISTORY_AT, HISTORY) == substr(prev, SLOTS, HISTORY), "history");
    let opMsg = sha256(ctrlTxid + next);
    require(checkSigFromStack(opSig, adminPk, opMsg), "operator");
    continues(next);
  }

  function read(int selfIndex) {
    require(selfIndex == this.activeInputIndex, "self index");
    bytes state = tx.packet(STATE);
    require(state == tx.inputs[selfIndex].packet(STATE), "state carried");
    require(tx.outputs[0].value >= tx.input.current.value + readFee, "read fee");
    continues(state);
  }

  function migrate(bytes32 next, signature[5] sigs, signature opSig) {
    require(this.activeInputIndex == 0, "beacon is input 0");
    distinctSigners();
    bytes state = tx.packet(STATE);
    require(state == tx.inputs[0].packet(STATE), "state carried");
    require(size(state) == SIZE, "state size");
    int round = bin2num(substr(state, 1, 8));
    let msg = sha256(domain + "migrate" + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(round, 8) + next);
    quorum(msg, sigs);
    require(checkSigFromStack(opSig, adminPk, msg), "oracle service");
    aboveSubdust();
    require(tx.outputs[0].scriptPubKey == next, "next script");
    require(tx.outputs[0].value >= tx.input.current.value, "value");
    require(tx.outputs[0].value >= minValue, "minimum");
    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, "identity asset");
  }

  function unilateral(signature adminSig) tapscript {
    require(older(exit));
    require(checkSig(adminSig, adminPk));
  }
}
