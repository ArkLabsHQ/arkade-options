# Loaded by arkade-regtest when this repo is its parent (../.env.regtest),
# and by `pnpm smoke:regtest` via --env.
#
# The option contracts bake EXIT = 2048 seconds and assume zero intent fees,
# matching Mutinynet. arkd treats a locktime >= 512 as seconds and requires
# every delay to share that unit. BIP68 seconds are multiples of 512.
# The SDK's regtest wallet floors are 1200s (checkpoint) and 6000s (batch).

REGTEST_PROFILES=emulator

ARKD_UNILATERAL_EXIT_DELAY=2048
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=2048
ARKD_CHECKPOINT_EXIT_DELAY=4096
ARKD_BOARDING_EXIT_DELAY=604672
ARKD_VTXO_TREE_EXPIRY=604672

ARKD_SESSION_DURATION=10
AUTOMINE_INTERVAL=0

ARK_OFFCHAIN_INPUT_FEE=0.0
ARK_ONCHAIN_INPUT_FEE=0.0
ARK_OFFCHAIN_OUTPUT_FEE=0.0
ARK_ONCHAIN_OUTPUT_FEE=0.0
