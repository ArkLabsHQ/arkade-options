{
  "name": "arkade-options",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --experimental-strip-types --test app/settle-math.test.mjs app/account.test.mjs protocol/protocol.test.ts protocol/lifecycle.test.ts protocol/intent-state.test.ts protocol/deribit.test.ts protocol/beacon.test.ts oracle/service.test.ts desk/book.test.ts desk/fill.test.ts viz/flow.test.mjs && pnpm check",
    "desk": "node --experimental-strip-types --experimental-eventsource desk/main.ts",
    "oracle:page": "esbuild oracle/page.ts --bundle --format=esm --platform=browser --outfile=oracle/page.js --log-level=warning",
    "oracle": "pnpm oracle:page && node --experimental-strip-types oracle/main.ts",
    "e2e": "node --experimental-strip-types scripts/e2e-mutinynet.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "file:vendor/arkade-os-sdk-0.4.74-411b43f.tgz",
    "@noble/curves": "2.0.1",
    "@scure/base": "2.0.0",
    "nostr-tools": "2.17.4"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "esbuild": "0.25.10",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
